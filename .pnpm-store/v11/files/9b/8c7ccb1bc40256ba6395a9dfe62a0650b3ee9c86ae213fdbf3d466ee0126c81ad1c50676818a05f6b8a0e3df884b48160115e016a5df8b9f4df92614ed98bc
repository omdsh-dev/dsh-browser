{
  "name": "@deepseek-ai/dsh-session-format-v1-to-v2",
  "description": "Frozen released-v1 Session codec and assistant-stream migration to v2",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-v1-to-v2"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 1,
      "to": 2,
      "export": ".",
      "migration": "sessionFormatV1ToV2",
      "sourceCodec": "releasedV1SessionFormatCodec",
      "targetCodec": "releasedV2SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV2Header",
      "targetRestorer": "restoreReleasedV2Artifact"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-format": "^0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2"
  }
}